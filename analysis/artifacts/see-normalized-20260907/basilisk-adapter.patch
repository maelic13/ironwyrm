+static std::string see_verdicts(const std::vector<Board>& boards) {
+    MoveList ml;
+    std::vector<std::string> verdicts;
+    for (std::size_t index = 0; index < boards.size(); ++index) {
+        ml.count = 0;
+        boards[index].gen_legal_captures(ml);
+        for (Move m : ml) {
+            verdicts.push_back(std::to_string(index) + ":" + move_to_uci(m)
+                + "=" + (boards[index].see_ge(m, 0) ? "1" : "0"));
+        }
+    }
+    std::sort(verdicts.begin(), verdicts.end());
+    std::string result;
+    for (std::size_t i = 0; i < verdicts.size(); ++i) {
+        if (i != 0) result += ',';
+        result += verdicts[i];
+    }
+    return result;
+}
